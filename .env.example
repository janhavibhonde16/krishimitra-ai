# GEMINI_API_KEY: Required for Gemini AI API calls (Chatbot, Crop Recommendation, Disease Diagnosis, Weather Farming Advice).
GEMINI_API_KEY=

# OPENWEATHER_API_KEY: Optional OpenWeatherMap API key for live real-time hyperlocal weather data.
OPENWEATHER_API_KEY=

# DISEASE_DETECTION_API_KEY: Kindwise plant.health API key for crop disease detection.
DISEASE_DETECTION_API_KEY=

# MANDI_API_KEY: Optional Data.gov.in / Agmarknet API key for real-time Mandi market rates.
MANDI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

